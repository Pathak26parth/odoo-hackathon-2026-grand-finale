# Server Configuration
NODE_ENV=development
PORT=5000

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=peoplepay360
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_CONNECTION_LIMIT=10

# Security & JWT Tokens
JWT_ACCESS_SECRET=your_jwt_access_secret_key_min_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Frontend CORS URL
FRONTEND_URL=http://localhost:5173

# Password Hashing & Expirations
BCRYPT_SALT_ROUNDS=12
EMAIL_VERIFICATION_EXPIRATION_HOURS=24
PASSWORD_RESET_EXPIRATION_HOURS=1

# Cloudinary Cloud Storage (for employee profile photos & documents)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email / SMTP Configuration (Gmail, Sendgrid, Mailgun, Amazon SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
MAIL_FROM=PeoplePay360 <no-reply@peoplepay360.com>

# Python Face Biometrics Service
FACE_SERVICE_URL=http://localhost:8000

# Application-Level Document Encryption (AES-256-GCM 256-bit Key / 64 Hex chars)
DOC_ENCRYPTION_KEY=c3ab8e6f10274a589dc2e4b8593a1df048291be059c3817f649204859a1bcdef
